/* Engine notes and errors (StitchKit) */
"The pair %@ ↔ %@ was left out of the alignment (%.1f px off the others)" = "La coppia %@ ↔ %@ è stata esclusa dall'allineamento (%.1f px di scarto rispetto alle altre)";
